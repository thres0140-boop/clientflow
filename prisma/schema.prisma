generator client {
  provider        = "prisma-client-js"
  output          = "../app/generated/prisma/client"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider  = "postgresql"
  url       = env("STORAGE2_POSTGRES_PRISMA_URL")
  directUrl = env("STORAGE2_POSTGRES_URL_NON_POOLING")
}

model Client {
  id                 Int      @id @default(autoincrement())
  name               String
  platform           String
  profileUrl         String?
  color              String   @default("#6366f1")
  notes              String?
  captionStyle       String?
  captionGuidelines  String?
  dayTemplate        String?
  language           String   @default("nl")
  scriptAlternatives Int      @default(5)
  generationInterval Int      @default(2)
  createdAt          DateTime @default(now())

  bookingLink           String?
  scriptRules           String?
  ctaKeyword            String?  // e.g. "regie" — inbound DMs containing this are flagged as CTA leads
  isTestAccount         Boolean  @default(false)

  concepts              Concept[]
  contentPieces         ContentPiece[]
  trackedVideos         TrackedVideo[]
  workflowStages        WorkflowStage[]
  scriptDrafts          ScriptDraft[]
  creators              Creator[]
  messages              Message[]
  competitors           Competitor[]
  board                 Board?
  instagramConnection   InstagramConnection?
  analyticsEntries      AnalyticsEntry[]
  dmLeads               DmLead[]
  conceptFeedbacks      ConceptFeedback[]
  teamMembers           TeamMember[]
}

model InstagramConnection {
  id                Int      @id @default(autoincrement())
  clientId          Int      @unique
  accessToken       String
  igUserId          String
  igUsername        String?
  followers         Int?
  unipileAccountId  String?
  zernioAccountId   String?
  zernioProfileId   String?
  profilePictureUrl String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
}


model Creator {
  id              Int      @id @default(autoincrement())
  clientId        Int
  name            String
  email           String?
  instagramHandle String?
  color           String   @default("#6366f1")
  notes           String?
  createdAt       DateTime @default(now())

  client         Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  workflowStages WorkflowStage[]
}

model Message {
  id        Int      @id @default(autoincrement())
  clientId  Int
  content   String
  author    String   @default("owner")
  channel   String   @default("client") // "client" | "member:{id}"
  createdAt DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model TeamMember {
  id                Int       @id @default(autoincrement())
  clientId          Int?
  name              String
  email             String?
  role              String?
  color             String    @default("#6366f1")
  pageAccess        String    @default("all")
  viewOnlyPages     String    @default("") // comma-separated page ids the member can VIEW but not edit
  isClientAccount   Boolean   @default(false)
  passwordHash      String?
  inviteToken       String?   @unique
  inviteTokenExpiry DateTime?
  createdAt         DateTime  @default(now())

  client           Client?         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  stageAssignments WorkflowStage[]
  notifications    Notification[]
  stageCompletions StageHistory[]
}

model WorkflowStage {
  id                Int      @id @default(autoincrement())
  clientId          Int?
  name              String
  order             Int
  color             String   @default("#6366f1")
  assignedToId      Int?
  assignedCreatorId Int?
  assignedToOwner   Boolean  @default(false)
  assignedToClient  Boolean  @default(false)
  assignees         String   @default("[]")
  createdAt         DateTime @default(now())

  client          Client?        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  assignedTo      TeamMember?    @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  assignedCreator Creator?       @relation(fields: [assignedCreatorId], references: [id], onDelete: SetNull)
  history         StageHistory[]
  drafts          ScriptDraft[]
}

model StageHistory {
  id            Int       @id @default(autoincrement())
  contentId     Int
  stageId       Int
  completedAt   DateTime?
  completedById Int?
  notes         String?
  rawContentUrl String?
  createdAt     DateTime  @default(now())

  content     ContentPiece  @relation(fields: [contentId], references: [id], onDelete: Cascade)
  stage       WorkflowStage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  completedBy TeamMember?   @relation(fields: [completedById], references: [id], onDelete: SetNull)
}

model Notification {
  id        Int      @id @default(autoincrement())
  memberId  Int
  contentId Int
  stageId   Int
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  member  TeamMember   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  content ContentPiece @relation(fields: [contentId], references: [id], onDelete: Cascade)
}

model Competitor {
  id            Int      @id @default(autoincrement())
  clientId      Int
  handle        String
  name          String?
  niche         String?
  followerCount Int?
  followingCount Int?
  postCount     Int?
  bio           String?
  profilePicUrl String?
  verified      Boolean?
  lastProfileSyncAt DateTime?
  notes         String?
  profileUrl    String?
  createdAt     DateTime @default(now())
  lastScrapedAt DateTime?
  lastScrapeError String?

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  reels  CompetitorReel[]
}

// Provenance-aware example pool the script generator studies. `scriptExamples`
// on Concept stays the human-curated / reel-pulled set (trusted); this table adds
// accepted-but-unproven drafts (recent context) and performance-promoted winners.
model ConceptExample {
  id            Int      @id @default(autoincrement())
  conceptId     Int
  source        String   // human_seed | accepted_draft | proven_winner
  text          String
  hookKey       String?  // first-line hash for dedup
  scriptDraftId Int?
  reelShortcode String?
  format        String?  // talking_head | text_overlay | broll (for reel-derived examples)
  views         Int?
  createdAt     DateTime @default(now())

  concept Concept @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  @@index([conceptId, source])
}

// A competitor's reel, scraped + persisted. Stats live in snapshots over time.
model CompetitorReel {
  id            Int       @id @default(autoincrement())
  competitorId  Int
  shortcode     String
  caption       String?
  thumbnailUrl  String?
  mediaUrl      String?
  mediaUrlAt    DateTime?
  permalink     String?
  postedAt      DateTime?
  firstSeenAt   DateTime  @default(now())
  lastScrapedAt DateTime  @default(now())
  format        String?   // talking_head | text_overlay | broll | other (vision-classified)

  competitor Competitor               @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  snapshots  CompetitorReelSnapshot[]

  @@unique([competitorId, shortcode])
}

// Point-in-time stats for a reel — one row per scrape, so we can detect "exploded".
model CompetitorReelSnapshot {
  id           Int      @id @default(autoincrement())
  reelId       Int
  capturedAt   DateTime @default(now())
  viewCount    Int?
  likeCount    Int?
  commentCount Int?

  reel CompetitorReel @relation(fields: [reelId], references: [id], onDelete: Cascade)

  @@index([reelId, capturedAt])
}

model Board {
  id        Int      @id @default(autoincrement())
  clientId  Int      @unique
  snapshot  String   @default("{}")
  updatedAt DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model Concept {
  id             Int      @id @default(autoincrement())
  clientId       Int?
  name           String
  conceptType    String?
  hookType       String?
  textHook       String?
  audioHook      String?
  videoType      String?
  angle          String?
  structure      String?
  guidelines     String?
  exampleUrl     String?
  reelUrls       String?  // JSON array of reel permalinks attached to this concept
  textOverlay    Boolean  @default(false) // B-roll + on-screen text (no voiceover) — AI writes text hooks, not spoken scripts
  scriptExamples       String?
  scriptRules          String?
  aiMemory             String?
  memoryUpdatedAt      DateTime?
  conversationHistory  String   @default("[]")
  timesUsed            Int      @default(0)
  isIdea         Boolean  @default(false)
  notes          String?
  createdAt      DateTime @default(now())

  // Client-owned concept: the client writes the scripts themselves (no AI gen).
  clientOwned        Boolean  @default(false)
  clientQuota        Int?     // how many scripts the client must write per cycle
  clientIntervalDays Int?     // cycle length in days (7 = weekly, 14 = biweekly, 28 = ~monthly)
  clientAnchor       String?  // YYYY-MM-DD — first due date; cycles repeat every intervalDays from here

  client           Client?          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  contentPieces    ContentPiece[]
  trackedVideos    TrackedVideo[]
  scriptDrafts     ScriptDraft[]
  analyticsEntries AnalyticsEntry[]
  feedbacks        ConceptFeedback[]
  examples         ConceptExample[]
}

model ScriptDraft {
  id          Int      @id @default(autoincrement())
  clientId    Int
  conceptId   Int
  stageId     Int?
  title       String
  hook        String?
  script      String
  caption     String?
  weekLabel   String
  dayLabel    String?
  status      String   @default("pending")
  isSavedIdea     Boolean  @default(false)
  resurfaceAt     String?
  rawContentUrl      String?
  rawContentUrls     String   @default("[]")
  editedVideoUrl     String?
  uploadToken        String?  @unique
  checkReviewerIds   String   @default("[]")
  scheduledDate      String?
  zernioBooked       Boolean  @default(false)
  zernioPostId       String?
  clientAuthored     Boolean  @default(false)
  rejectionFeedback  String?
  generatedAt        DateTime @default(now())
  updatedAt          DateTime @updatedAt

  client  Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  concept Concept        @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  stage   WorkflowStage? @relation(fields: [stageId], references: [id], onDelete: SetNull)
  notes   DraftNote[]
  changes DraftChange[]
  reviews DraftReview[]
}

model DraftReview {
  id           Int      @id @default(autoincrement())
  draftId      Int
  reviewerName String
  reviewerId   Int?
  status       String   @default("pending")
  comment      String?
  createdAt    DateTime @default(now())
  draft        ScriptDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
}

model ContentPiece {
  id             Int      @id @default(autoincrement())
  clientId       Int
  conceptId      Int?
  title          String
  script         String?
  contentType    String   @default("video")
  status         String   @default("scripted")
  platform       String?
  scheduledDate  String?
  hook           String?
  caption        String?
  notes          String?
  currentStageId Int?
  rawContentUrl  String?
  igMediaId      String?
  zernioPostId   String?
  createdAt      DateTime @default(now())

  client        Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  concept       Concept?       @relation(fields: [conceptId], references: [id], onDelete: SetNull)
  stageHistory  StageHistory[]
  notifications Notification[]
}

model TrackedVideo {
  id         Int      @id @default(autoincrement())
  clientId   Int
  conceptId  Int?
  title      String
  url        String?
  views      Int      @default(0)
  likes      Int      @default(0)
  comments   Int      @default(0)
  shares     Int      @default(0)
  saves      Int      @default(0)
  hookUsed   String?
  hookType   String?
  datePosted String?
  notes      String?
  createdAt  DateTime @default(now())

  client  Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  concept Concept? @relation(fields: [conceptId], references: [id], onDelete: SetNull)
}

model AnalyticsEntry {
  id               Int      @id @default(autoincrement())
  clientId         Int
  date             String   // YYYY-MM-DD
  conceptId        Int?
  views            Int      @default(0)
  likes            Int      @default(0)
  shares           Int      @default(0)
  follows          Int      @default(0)
  messagesSent     Int      @default(0)
  messagesAnswered Int      @default(0)
  linksSent        Int      @default(0)
  bookedCalls      Int      @default(0)
  videoLink        String?  // reel/video URL for the day (auto-detected or pasted manually)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  client  Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  concept Concept? @relation(fields: [conceptId], references: [id], onDelete: SetNull)

  @@unique([clientId, date])
}

model DraftNote {
  id        Int      @id @default(autoincrement())
  draftId   Int
  content   String
  author    String
  createdAt DateTime @default(now())

  draft ScriptDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
}

model DraftChange {
  id        Int      @id @default(autoincrement())
  draftId   Int
  field     String
  before    String
  after     String
  author    String
  createdAt DateTime @default(now())

  draft ScriptDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
}

model DmLead {
  id        Int      @id @default(autoincrement())
  clientId  Int
  name      String
  handle    String?
  status    String   @default("messaged") // messaged | link_sent | booked | showed | no_show | closed
  date      String?  // YYYY-MM-DD date first messaged
  repliedAt String?  // YYYY-MM-DD date the prospect first replied (null = no reply yet)
  source    String?  // "cta" = inbound from a CTA keyword DM, else null/outbound
  convId    String?  // Zernio conversation id — primary dedup key (handles anonymous DMs)
  linkSentAt String? // ISO timestamp the booking link was actually sent (from the message)
  bookedAt   String? // YYYY-MM-DD the call was booked
  lastConvTime String? // Zernio conversation updatedTime at last message-scan (skip refetch if unchanged)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model ConceptFeedback {
  id            Int      @id @default(autoincrement())
  conceptId     Int
  clientId      Int
  title         String
  hook          String?
  scriptSnippet String?
  reasonType    String   // others_better | wrong_angle | hook_bad | too_long | too_short | off_brand | custom
  reason        String?
  createdAt     DateTime @default(now())

  concept Concept @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  client  Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
}
