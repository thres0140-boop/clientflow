{
  "name": "clientflow",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/check-db-boundaries.mjs && node scripts/build-ai-migrations.mjs && prisma generate && prisma generate --schema prisma-ai/schema.prisma && next build",
    "check:boundaries": "node scripts/check-db-boundaries.mjs",
    "start": "next start",
    "lint": "eslint",
    "db:ai:generate": "prisma generate --schema prisma-ai/schema.prisma",
    "db:ai:init-sql": "prisma migrate diff --from-empty --to-schema-datamodel prisma-ai/schema.prisma --script",
    "db:ai:diff": "prisma migrate diff --from-url \"$AI_POSTGRES_URL_NON_POOLING\" --to-schema-datamodel prisma-ai/schema.prisma --script"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.95.1",
    "@aws-sdk/client-s3": "^3.1063.0",
    "@aws-sdk/s3-request-presigner": "^3.1063.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@excalidraw/excalidraw": "^0.18.1",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@neondatabase/serverless": "^0.10.4",
    "@prisma/adapter-neon": "^5.22.0",
    "@prisma/client": "5.22.0",
    "@vercel/blob": "^2.4.0",
    "bcryptjs": "^3.0.3",
    "ffmpeg-static": "^5.3.0",
    "jose": "^6.2.3",
    "next": "16.2.4",
    "prisma": "5.22.0",
    "qrcode.react": "^4.2.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "spark-md5": "^3.0.2",
    "web-push": "^3.6.7",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/spark-md5": "^3.0.5",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
